{
  "expo": {
    "name": "CardioIA",
    "slug": "cardioia",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardioia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.fiap.drell.cardioia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDF0F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.drell.cardioia"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CardioIA",
      "shortName": "CardioIA",
      "themeColor": "#0B7A84",
      "backgroundColor": "#F3F6F7",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A84",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O CardioIA precisa acessar suas fotos para enviar imagens de exames de ECG.",
          "cameraPermission": "O CardioIA usa a câmera para fotografar exames de ECG.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "Monitoramento cardiológico integrado: IoT, IA multiagente, chatbot e visão computacional (FIAP - Grupo DRELL)",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cbafc363-866e-4c2a-8cdb-0c8d3044a207"
      }
    },
    "owner": "seberino"
  }
}
