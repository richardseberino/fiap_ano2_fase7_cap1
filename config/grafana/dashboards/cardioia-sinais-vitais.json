          "type": "influxdb",
          "uid": "influxdb-cardioia"
        },
        "refresh": 2,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"paciente_id\", predicate: (r) => r._measurement == \"sinais_vitais\", start: -7d)",
        "definition": "paciente_id",
        "current": {},
        "sort": 1
      }
    ]
