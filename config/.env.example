# Copie para a raiz do repositório como .env (docker compose) ou para config/secrets.env (Kubernetes).
INFLUX_TOKEN=cardioia-dev-token-troque-em-producao
INFLUX_ADMIN_USER=fiap
INFLUX_ADMIN_PASSWORD=fiap@1234
INFLUX_ORG=fiap
INFLUX_BUCKET=dados-medicos
GRAFANA_ADMIN_PASSWORD=admin
# Opcional: sem chave, o multiagente roda no modo offline (ML + protocolos, sem LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional: IBM Watson Assistant (sem isso o chatbot usa o motor NLP local)
USE_WATSON=false
WATSON_APIKEY=
WATSON_URL=
WATSON_ASSISTANT_ID=
